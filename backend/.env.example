# 复制为 backend/.env 并填写真实值；以下项均为必填（除 REDIS_USERNAME 可留空）。
# 环境变量名与 ProjectConfig 字段名一致（不区分大小写）。

# 安全认证（建议: openssl rand -hex 32）
AUTH_SECRET_KEY=your-secret-key-at-least-32-chars-long

# MySQL（Tortoise）
DATABASE_USERNAME=root
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=krun

# Redis（无 ACL 用户名时 REDIS_USERNAME 留空；无密码时 REDIS_PASSWORD 留空）
REDIS_USERNAME=
REDIS_PASSWORD=your-redis-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
