# *============================================================*
# === === === === === === 环境配置文件 === === === === === === ===
# *============================================================*

# 服务启动端口与调试开关
SERVER_PORT=
SERVER_DEBUG=

# 安全认证（密钥长度不小于64位）
AUTH_SECRET_KEY=""

# 第三方迁移用户和应用校验地址
THIRD_PARTY_USER_AUTH_URL=""
THIRD_PARTY_SYNC_APPS_URL=""

# MySQL
DATABASE_USERNAME=""
DATABASE_PASSWORD=""
DATABASE_HOST=""
DATABASE_PORT=""
DATABASE_NAME=""

# Redis
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_HOST=""
REDIS_PORT=""

# Celery Redis 库号
CELERY_BROKER_DB=
CELERY_BACKEND_DB=
CELERY_REDBEAT_DB=

# Oracle Instance Client
# 连接模式(thick/thin): thin不兼容11g/部分12.1；
# 连11g需InstantClient19；Client21仅支持DB12.1+，Client23仅支持DB19+
ORACLE_CLIENT_MODE=thick
# Oracle Instant Client目录：MacOS/Windows一般必填；Linux可用ldconfig/LD_LIBRARY_PATH时可留空
ORACLE_CLIENT_PATH=

# 历史日志保留天数：启动时按最后修改时间清理应用/Celery 日志文件；0=不清理
LOGGER_RETENTION_DAYS=30

# 性能测试（VictoriaMetrics本机部署时默认 http://127.0.0.1:8428/api/v1/import/prometheus；留空则不上报时序指标）
PERF_VICTORIA_METRICS_URL=""
